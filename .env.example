# Copy to .env and fill in. .env is gitignored — never commit these values.
#
# Find these values:
#  - Serial + access code: Bambu Handy app -> printer -> Settings (bottom of the
#    About screen), or on the label under the printer.
#  - Host: the printer's LAN IP (Bambu Handy -> printer -> Settings -> Network).

BAMBU_HOST=192.168.1.100
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=

# Optional, for the remote vision provider:
# REMOTE_API_KEY=
